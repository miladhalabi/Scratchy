{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "skipLibCheck": true, "lib": ["ES2022", "DOM", "DOM.Iterable"], "verbatimModuleSyntax": true,
    "types": ["svelte"], "allowImportingTsExtensions": true, "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.svelte"]
}
